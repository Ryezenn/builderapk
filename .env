# =========================================================================
# BuildrX SaaS Platform Environment Configuration Template
# =========================================================================

# General Environment Options
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Database & Cache Connection Pools
DATABASE_URL=postgresql://user:pass@localhost:5432/buildrx?schema=public
REDIS_URL=redis://localhost:6379

# JWT Cryptographic Secrets (generate strong random tokens)
JWT_SECRET=buildrx_fallback_jwt_secret_key_12345
REFRESH_SECRET=buildrx_fallback_refresh_secret_key_67890

# Background Worker Settings
# If set to true, enqueued builds will simulate delays, progress updates,
# and output mock files instantly without requiring native Java/Gradle/Android toolchains.
SIMULATE_APK_BUILD=true
KEYSTORE_PASS=buildrxpass
KEYSTORE_PATH=/certs/buildx.keystore

# AWS S3 / MinIO File Storage Fallbacks
# Leave blank to utilize fallback local public uploads static directories.
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=

# Nodemailer SMTP Mail parameters
# Leave blank to print email templates outputs directly inside node consoles.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BuildrX" <noreply@buildrx.com>

# Payment integrations Server Keys
MIDTRANS_SERVER_KEY=
STRIPE_SECRET_KEY=

# Superadmin moderator privileges email
ADMIN_EMAIL=admin@buildrx.com
